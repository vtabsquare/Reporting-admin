# Copy this file to backend/.env and configure it locally.
# Never commit or distribute the service-role key or Brevo API key.

SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

BREVO_API_KEY=YOUR_BREVO_API_KEY
VTAB_SMTP_FROM=verified-sender@example.com

# First administrator only. Additional admins use governed token enrollment.
ADMIN_EMAIL=admin@example.com

# Optional explicit emergency key. Leave blank to disable the bypass.
ADMIN_MASTER_KEY=
ADMIN_SESSION_SECONDS=28800

SERVICES_API_URL=http://127.0.0.1:8830/api/v1
